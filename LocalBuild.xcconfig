// LocalBuild.xcconfig
// Build configuration for local builds with an ad-hoc fallback when no Apple Development identity is available.
// Used by `make local` — does NOT affect Debug or Release configurations.

// Local build commands pass either a stable identity or an explicit ad-hoc identity (`-`).
CODE_SIGN_IDENTITY = $(VOICEINK_LOCAL_CODESIGN_IDENTITY)
CODE_SIGN_IDENTITY[sdk=macosx*] = $(VOICEINK_LOCAL_CODESIGN_IDENTITY)
CODE_SIGN_STYLE = Manual
DEVELOPMENT_TEAM =
PROVISIONING_PROFILE_SPECIFIER =

// A self-signed local identity has no Apple Team ID, so the Debug launcher cannot load a separately signed debug dylib.
ENABLE_DEBUG_DYLIB = NO

// Entitlements are set via absolute path in the Makefile command line
// (relative paths break SPM package targets that resolve from their own source root)

// Add LOCAL_BUILD compilation flag so Swift code can use #if LOCAL_BUILD
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) LOCAL_BUILD
VOICEINK_UPDATER_KIND = fork
