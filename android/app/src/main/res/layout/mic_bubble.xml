<?xml version="1.0" encoding="utf-8"?>
<!-- The mic bubble's overlay window: either the expanded mic/card or the collapsed edge handle. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/bubble_expanded"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:gravity="end"
        android:orientation="vertical"
        android:padding="4dp">

        <LinearLayout
            android:id="@+id/bubble_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bubble_card_background"
            android:elevation="4dp"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/bubble_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:accessibilityLiveRegion="polite"
                android:maxWidth="260dp"
                android:paddingBottom="8dp"
                android:textColor="@color/keyboard_text"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/bubble_discard"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/action_discard"
                    android:textColor="@color/keyboard_secondary"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/bubble_copy"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/action_copy"
                    android:textColor="@color/accent"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/bubble_action"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textColor="@color/accent"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <!-- 48dp: the smallest comfortable touch target; the icon is scaled into the padding. -->
            <ImageButton
                android:id="@+id/bubble_mic"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:layout_margin="4dp"
                android:background="@drawable/bubble_mic_background"
                android:contentDescription="@string/cd_start"
                android:elevation="4dp"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mic"
                android:tint="@color/bubble_mic_icon" />

            <ProgressBar
                android:id="@+id/bubble_progress"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:elevation="5dp"
                android:indeterminate="true"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Slim edge handle shown when idle auto-collapse tucks the bubble against the screen edge. -->
    <FrameLayout
        android:id="@+id/bubble_handle"
        android:layout_width="28dp"
        android:layout_height="56dp"
        android:clickable="true"
        android:clipToPadding="false"
        android:contentDescription="@string/cd_expand_bubble"
        android:focusable="true"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <View
            android:id="@+id/bubble_handle_tab"
            android:layout_width="16dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/bubble_handle_right_background"
            android:elevation="4dp" />
    </FrameLayout>
</FrameLayout>
