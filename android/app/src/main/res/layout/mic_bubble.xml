<?xml version="1.0" encoding="utf-8"?>
<!-- The mic bubble's overlay window. Its gravity follows the side the bubble is docked on. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:gravity="end"
    android:orientation="vertical"
    android:padding="4dp">

    <LinearLayout
        android:id="@+id/bubble_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bubble_card_background"
        android:elevation="4dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="8dp"
        android:paddingBottom="2dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/bubble_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:accessibilityLiveRegion="polite"
            android:maxWidth="260dp"
            android:paddingBottom="8dp"
            android:textColor="@color/keyboard_text"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/bubble_discard"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/action_discard"
                android:textColor="@color/keyboard_secondary"
                android:visibility="gone" />

            <Button
                android:id="@+id/bubble_action"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:textColor="@color/accent"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageButton
            android:id="@+id/bubble_mic"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:layout_margin="4dp"
            android:background="@drawable/mic_button_background"
            android:contentDescription="@string/cd_start"
            android:elevation="4dp"
            android:src="@drawable/ic_mic" />

        <ProgressBar
            android:id="@+id/bubble_progress"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:elevation="5dp"
            android:indeterminate="true"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
