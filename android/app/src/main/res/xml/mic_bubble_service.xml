<?xml version="1.0" encoding="utf-8"?>
<!-- Window and focus events tell the bubble when a keyboard opens or closes and which field it serves. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowsChanged|typeWindowStateChanged|typeViewFocused"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/bubble_service_description"
    android:notificationTimeout="50" />
